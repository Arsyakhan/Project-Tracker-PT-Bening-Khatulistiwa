# Salin file ini jadi .env.local, lalu isi nilai di sebelah kanan tanda "=".
# .env.local TIDAK ikut ke GitHub (sudah masuk .gitignore) -- aman menaruh secret di sana.
# Semua variabel yang sama juga wajib diisi di Vercel > Project Settings > Environment Variables.

# --- Backend Apps Script (dari Bagian 1 README, hasil fungsi setup()) ---
GAS_API_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec
GAS_API_TOKEN=isi-dengan-API_TOKEN-dari-Script-Properties

# --- Login Google (dari Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=isi-dengan-client-secret

# --- Siapa saja yang boleh login, pisahkan dengan koma, tanpa spasi setelah koma ---
ALLOWED_EMAILS=nama1@gmail.com,nama2@gmail.com

# --- NextAuth ---
# NEXTAUTH_SECRET: string acak untuk menandatangani sesi login. Generate dengan:
#   openssl rand -base64 32
NEXTAUTH_SECRET=isi-dengan-string-acak-panjang
# NEXTAUTH_URL: alamat lengkap aplikasi kamu. Wajib diisi di Vercel (production);
# di komputer sendiri (npm run dev) boleh dikosongkan, default-nya http://localhost:3000
NEXTAUTH_URL=https://nama-project-kamu.vercel.app
